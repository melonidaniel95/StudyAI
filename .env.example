# === Supabase (obbligatorio) ===
# Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chiave service role: usarla SOLO lato server (script/manutenzione). Mai esporla al client.
SUPABASE_SERVICE_ROLE_KEY=

# === URL applicazione (usato per i link email di Supabase Auth) ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Assistente AI (facoltativo: l'app funziona anche senza) ===
# Provider supportati: anthropic | openai | none
AI_PROVIDER=none
AI_API_KEY=
# Modello da usare; se vuoto viene usato il default del provider
AI_MODEL=
# Limite giornaliero di richieste AI per utente
AI_DAILY_REQUEST_LIMIT=50
