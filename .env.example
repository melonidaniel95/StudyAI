# ============================================================================
# MODELLO — questo file è tracciato da Git e NON deve mai contenere segreti.
# Copialo in .env.local (escluso da Git) e inserisci lì i valori veri.
#   Windows:  copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
# ============================================================================

# === Supabase (obbligatorio) ===
# Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service role: usarla SOLO lato server (script/manutenzione).
# StudyAI non ne ha bisogno nel funzionamento normale. Mai esporla al client.
SUPABASE_SERVICE_ROLE_KEY=

# === URL applicazione (usato per i link email di Supabase Auth) ===
# In produzione: l'indirizzo del deploy, es. https://studyai.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Assistente AI (facoltativo: l'app funziona anche senza) ===
# Provider supportati: anthropic | openai | none
AI_PROVIDER=none
# Chiave del provider scelto. Lasciala vuota qui: va solo in .env.local.
AI_API_KEY=
# Modello da usare; se vuoto viene usato il default del provider
# (anthropic: claude-sonnet-4-5 · openai: gpt-4o-mini)
AI_MODEL=
# Limite giornaliero di richieste AI per utente
AI_DAILY_REQUEST_LIMIT=50
